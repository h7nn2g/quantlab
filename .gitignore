
# ==========================================
# QuantLab - Git Ignore
# ==========================================

# Python virtual environments
venv/
.venv/
env/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Python build files
build/
dist/
*.egg-info/
.eggs/

# Environment variables and API keys
.env
.env.*
!.env.example
*.pem
*.key

# Market data (downloaded datasets)
data/raw/
data/processed/
*.parquet
*.feather

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# IDE settings
.vscode/
.idea/

# Operating system
.DS_Store
Thumbs.db

# Temporary files and logs
*.log
*.tmp
*.bak
~$*

# C++ build artifacts (for future engine)
cpp/build/
CMakeFiles/
CMakeCache.txt
*.o
*.obj
*.exe
*.dll
*.pdb
